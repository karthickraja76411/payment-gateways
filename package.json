{
  "name": "payment-gateway",
  "version": "1.0.0",
  "description": "Stateless payment gateway client using gateway REST APIs (Razorpay and CCAvenue supported).",
  "main": "./dist/index.cjs",
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "payment",
    "razorpay",
    "ccavenue",
    "payment-gateway"
  ],
  "type": "module",
  "dependencies": {
    "axios": "^1.20.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/karthickraja76411/payment-gateways.git"
  },
  "author": "Karthick Raja <davidjkej@gmail.com>",
  "publishConfig": {
    "access": "public"
  }
}